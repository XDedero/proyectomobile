# Configure these in the hosting environment; Django does not load this file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=app.tudominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.tudominio.cl
DJANGO_SECURE_SSL_REDIRECT=true
# Enable only behind your trusted HTTPS reverse proxy (automatic on Render).
DJANGO_TRUST_PROXY=true
# Optional: set true only when every subdomain permanently supports HTTPS.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Render Free: PostgreSQL is primary and original documents live in Drive.
# No persistent disk and no /var/data directory are required in this mode.
PLANOS_CLOUD_MODE=1
PLANOS_DATABASE_SCHEMA=app_runtime
APP_TERMINAL_DEBUG=1
WEB_CONCURRENCY=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
# Solicitudes y cuentas aprobadas compartidas. Requiere la conexión de servidor a Supabase.
APP_SHARED_ACCOUNTS=1
# Conexión PostgreSQL privada del servidor. Use el pooler de Supabase y guárdela
# como variable secreta; nunca la exponga en JavaScript ni la confirme en Git.
SUPABASE_DATABASE_URL=postgresql://usuario:clave@host:5432/postgres?sslmode=require
# Add Secret File gdrive-token-seed.json in Render; its contents come from the
# authorized local gdrive-token.json. Never commit that file or a real DB URI.
